{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "everythingcrystalmountain",
  "main": "worker.js",
  "compatibility_date": "2026-06-07",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
