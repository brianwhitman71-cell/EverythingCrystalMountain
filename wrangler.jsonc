{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "everythingcrystalmountain",
  "main": "worker.js",
  "compatibility_date": "2026-06-07",
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "everythingcrystalmountain.com", "custom_domain": true },
    { "pattern": "www.everythingcrystalmountain.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
